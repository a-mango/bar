# systemd user unit for the live copy. Installed at cutover (M8) to
# ~/.config/systemd/user/, see docs/PLAN.md section 6.
[Unit]
Description=bar: status bar and notification daemon (Quickshell)
PartOf=graphical-session.target
After=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=dbus
BusName=org.freedesktop.Notifications
ExecCondition=/bin/sh -c '[ -n "$WAYLAND_DISPLAY" ]'
ExecStart=/usr/bin/quickshell -p %h/.local/share/bar --no-duplicate
Restart=on-failure
RestartSec=1

[Install]
WantedBy=sway-session.target
